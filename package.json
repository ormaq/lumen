{
  "name": "lumen-optics-studio",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Offline fullscreen 3D geometric optics workbench",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node --expose-gc benchmarks/compare.mjs",
    "test:performance": "node --expose-gc benchmarks/compare.mjs --check --output=benchmarks/after.json",
    "test:browser-performance": "node build.mjs && node benchmarks/build-baseline.mjs && python tests/browser_performance_v5.py"
  },
  "engines": {
    "node": ">=18"
  }
}
